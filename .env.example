# ============================================================
#  RAG Chat Bot — Required Credentials (TEMPLATE)
# ------------------------------------------------------------
#  Copy this file to ".env" and fill in your OWN keys.
#  The ".env" file is ignored by git and will NEVER be uploaded.
#  You add these keys inside n8n's "Credentials" screen — see README.
# ============================================================

# 1) OpenAI — used for the chat model (GPT-4.1) and for embeddings.
#    Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# 2) Pinecone — the vector database that stores your documents.
#    Get it from: https://app.pinecone.io  (API Keys section)
PINECONE_API_KEY=your-pinecone-key-here

# Name of the Pinecone index this workflow expects (already set in the JSON).
PINECONE_INDEX=aasiaforge-rag
